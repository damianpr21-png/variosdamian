# ===== Obligatorio =====
# Clave de la API de Claude: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Contraseña para entrar al panel (usuario: cualquiera)
PANEL_PASSWORD=cambia-esta-clave

# ===== WhatsApp (API oficial de Meta) =====
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=inventa-un-texto-secreto
WHATSAPP_APP_SECRET=

# Dirección pública del servidor (para webhook y fotos de productos), ej: https://mivendedor.com
PUBLIC_URL=

# ===== Opcional =====
PORT=3000
TIMEZONE=America/Guayaquil
# Modelo de IA. Por defecto claude-opus-5-5. Para bajar costos puedes probar claude-sonnet-5-5 o claude-haiku-5-5.
IA_MODELO=claude-opus-5-5
# Esfuerzo de razonamiento: low (rápido y barato, recomendado para chat) | medium | high
IA_ESFUERZO=low
